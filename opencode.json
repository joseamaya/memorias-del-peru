{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "blender": {
      "type": "local",
      "command": [
        "/home/jamaya/.local/bin/uvx",
        "--python",
        "3.11",
        "mcp-for-blender"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "BLENDER_MCP_SAFE_MODE": "1",
        "DISABLE_TELEMETRY": "true",
        "UV_PYTHON_PREFERENCE": "only-managed"
      }
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "godot-docs": {
        "type": "local",
        "command": ["npx", "-y", "@fernforestgames/mcp-server-godot-docs"],
        "environment": {
          "GODOT_PATH": "godot"
        }
      }
    }
  }
}
