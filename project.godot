[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="npc"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=false
3d/default_gravity=9.8

[rendering]

; El suelo y los muros se ven en ángulo rasante: sin anisotropía, el detalle
; fino se convierte en franjas al fondo.
textures/default_filters/anisotropic_filtering_level=3

renderer/rendering_method="forward_plus"

[internationalization]

locale/translations=PackedStringArray("res://core/localization/core_texts.es.translation", "res://campaigns/01_pachacutec/localization/pachacutec_texts.es.translation")
locale/fallback="es"

[memorias]

campaign/first="res://campaigns/01_pachacutec/campaign.tres"
